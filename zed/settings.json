// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": false,
  },
  "icon_theme": "VSCode Great Icons Theme",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "ollama",
      "model": "gemma4:latest",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "base_keymap": "VSCode",
  "status_bar": {
    "experimental.show": false,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "buffer_line_height": {
    "custom": 2.3,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_shape": "block",
  "cursor_blink": true,
  "buffer_font_fallbacks": ["JetBrains Mono"],
  "buffer_font_family": "JetBrains Mono",
  "soft_wrap": "editor_width",
  "ui_font_size": 18,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
}
